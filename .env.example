# Server Configuration
HOST=0.0.0.0
PORT=1337

# Frontend & CORS Configuration
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Admin Authentication
# These credentials will be verified dynamically per request on the login endpoint.
ADMIN_USERNAME=your_username
ADMIN_PASSWORD=your_secure_password
JWT_SECRET=your_jwt_secret_token

# Resend Mail Configuration
RESEND_API_KEY=re_your_resend_api_key
RESEND_DEFAULT_FROM=sender@yourdomain.com
CONTACT_RECEIVER_EMAIL=your_inbox@email.com

# Database (Neon PostgreSQL / Any Postgres Instance)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_SSL=true

# Cloudinary Storage Configuration (For Admin Image Uploads)
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET=your_cloudinary_api_secret
